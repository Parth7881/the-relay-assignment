# Copy to .env; never paste or commit the key.
GROQ_API_KEY=
# Candidate, not yet benchmarked on your account.
GROQ_MODEL=openai/gpt-oss-20b
RELAY_DATA_DIR=data
RELAY_RUNS_DIR=runs
RELAY_DEADLINE_SECONDS=30
RELAY_MAX_OUTPUT_TOKENS=1200

# Local protective ceilings, not measured provider entitlements.
RELAY_CONCURRENCY=2
RELAY_QUEUE_CAPACITY=8
RELAY_QUEUE_WAIT_SECONDS=5
RELAY_RPM=30
RELAY_TPM=8000
RELAY_RPD=1000
RELAY_TPD=200000
RELAY_SOURCE=real
RELAY_SIMULATOR_PORT=8001
